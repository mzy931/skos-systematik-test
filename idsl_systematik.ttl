    skos:narrower idsl_systematik:GT1,
        idsl_systematik:GT2 ;
    skos:notation "GT" ;
    skos:prefLabel "Graphische Texte"@de ;
    skos:scopeNote "Graphic Novels / überwiegend deutschsprachiger Autor*innen"@de ;
    skos:topConceptOf idsl_systematik: .


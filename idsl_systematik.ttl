    skos:topConceptOf idsl_systematik: .

idsl_systematik:Z a skos:Concept ;
    skos:inScheme idsl_systematik: ;
    skos:notation "Z" ;
    skos:note "Zeitschriftenhefte des laufenden Jahrgangs können beim Bibliotheksteam in den Zimmern 2.003 und 2.004 bei Hinterlegung eines Ausweises eingesehen werden, soweit die Hefte nicht in der Zeitschriftenauslage liegen."@de ;
    skos:prefLabel "Zeitschriften"@de ;
    skos:topConceptOf idsl_systematik: .

idsl_systematik:a a skos:Concept ;
    skos:altLabel "a - Bücher zur Ausleihe"@de ;
    skos:inScheme idsl_systematik: ;
    skos:notation "a" ;
    skos:note "Die mit « a » bezeichneten Bücher können bei der Aufsicht für 3 Wochen ausgeliehen werden. Wir benötigen den Nachweis, dass Sie am IDSL I oder IDSL II studieren, sowie den Personalausweis bzw. Reisepass + Meldebescheinigung. Es wird eine Stammkarte ausgefüllt, die für ein Semester gilt. Für jedes einzelne Buch muss ein Leihschein ausgefüllt und unterschrieben werden. (Für mittelhochdeutsche und althochdeutsche Wörterbücher und Grammatiken gibt es eine Semesterausleihe.) Eine Verlängerung ist nur zweimal möglich. Wer die Bücher nicht rechtzeitig zurückgibt, wird ein Semester lang für die Ausleihe gesperrt."@de ;
    skos:prefLabel "Bücher zur Ausleihe"@de ;
    skos:topConceptOf idsl_systematik: .

idsl_systematik:GT a skos:Concept ;
    skos:editorialNote "GT auf Hierarchiestufe 2 (Sammelbände, Anthologien) entfernt."@de ;
